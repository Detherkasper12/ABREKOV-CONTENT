# Copy to .env.local for local work. On Vercel: Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Used to create signed upload URLs for Storage.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Transaction pooler" connection string (port 6543), with your DB password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Comma-separated. Only these Supabase Auth users can open /admin.
ADMIN_EMAILS=

# Public address of the site, no trailing slash. Used in sitemap and confirmation emails.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN

# Optional: newsletter double opt-in via Resend (https://resend.com). Leave empty to keep the form hidden.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "ABREKOV <hello@your-domain.com>"
NEWSLETTER_FROM_EMAIL=
